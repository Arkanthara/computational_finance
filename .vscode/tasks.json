{
  "version": "2.0.0",
  "tasks": [
    {
      // Runs the Python preprocessor in watch mode.
      // Re-preprocesses source and recompiles the PDF whenever a file changes.
      "label": "typst-pyexec: watch",
      "type": "shell",
      "command": "uv run typst_pyexec.py -w report.typ",
      "options": { "cwd": "${workspaceFolder}/report" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typst-pyexec",
        "pattern": { "regexp": "^\\[typst-pyexec\\]", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[typst-pyexec\\] Initial preprocessing",
          "endsPattern":   "\\[typst-pyexec\\] Watching"
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      }
    },
    {
      // One-shot compile: produces report.pdf without leaving anything running.
      "label": "typst-pyexec: compile",
      "type": "shell",
      "command": "uv run typst_pyexec.py -c report.typ",
      "options": { "cwd": "${workspaceFolder}/report" },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
